    },
    "Ollama's hosted models. Needs a key from ollama.com. The song list goes to ollama.com." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelle, die Ollama betreibt. Braucht einen Schlüssel von ollama.com. Die Songliste geht an ollama.com."
          }
        }
      }
    },
    "PICKED FOR YOU" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FÜR DICH AUSGEWÄHLT"
          }
        }
      }
    },
    "Provider" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anbieter"
          }
        }
      }
    },
    "Runs on your own computer. Nothing leaves your network – the most private choice." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läuft auf deinem eigenen Rechner. Nichts verlässt dein Netzwerk – die privateste Wahl."
          }
        }
      }
    },
    "Save key" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlüssel speichern"
          }
        }
      }
    },
    "Send song details to %@?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Songdaten an %@ senden?"
          }
        }
      }
    },
    "Sent per set: title, artist, album, genre, year and the favorite mark of about 150 songs, the last few songs the DJ played, and your wish if you type one. Never sent: your server address, your login, covers, your listening history or anything about audiobooks. At most 20 requests an hour." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro Set gesendet: Titel, Künstler, Album, Genre, Jahr und Favoriten-Markierung von rund 150 Songs, die letzten Songs, die der DJ gespielt hat, und dein Wunsch, falls du einen eintippst. Nie gesendet: deine Serveradresse, deine Anmeldung, Cover, dein Hörverlauf oder irgendetwas zu Hörbüchern. Höchstens 20 Anfragen pro Stunde."
          }
        }
      }
    },
    "Set up the DJ in the settings first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richte den DJ zuerst in den Einstellungen ein."
          }
