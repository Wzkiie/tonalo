    "Audiobooks & podcasts" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hörbücher & Podcasts"
          }
        }
      }
    },
    "Audiobooks (Audiobookshelf)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hörbücher (Audiobookshelf)"
          }
        }
      }
    },
    "Audiobooks and podcasts" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hörbücher und Podcasts"
          }
        }
      }
    },
    "Audiobooks and podcasts now show up under Home and Your Library. Your progress stays in sync with the server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hörbücher und Podcasts erscheinen jetzt unter Start und Bibliothek. Dein Fortschritt bleibt mit dem Server abgeglichen."
          }
        }
      }
    },
    "Audiobooks are big, so without cellular they wait for Wi-Fi. Your position is sent to the server as soon as there's a connection again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hörbücher sind groß, ohne Mobilfunk warten sie deshalb auf WLAN. Deine Position geht an den Server, sobald wieder eine Verbindung besteht."
          }
        }
      }
    },
    "Audiobooks at home" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hörbücher im Heimnetz"
          }
        }
      }
    },
    "Audiobooks you're listening to, gave a heart or downloaded show up here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier erscheinen Hörbücher, die du gerade hörst, mit einem Herz markiert oder heruntergeladen hast."
          }
        }
      }
    },
    "audiobooks.example.com or 192.168.1.10:13378" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "audiobooks.example.com oder 192.168.1.10:13378"
          }
        }
      }
    },
    "Audiobookshelf address" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audiobookshelf-Adresse"
          }
        }
      }
    },
    "Audiobookshelf can have an address for outside and one for home, plus custom headers for Cloudflare Access and similar." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audiobookshelf kann eine Adresse für unterwegs und eine für zu Hause haben, dazu eigene Header für Cloudflare Access und Ähnliches."
          }
        }
      }
    },
    "Audiobookshelf isn't connected." : {
