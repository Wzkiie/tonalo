            "value" : "Besseres CarPlay"
          }
        }
      }
    },
    "As a guest you add songs to what's playing there and skip. You need an account on the same server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als Gast fügst du Songs zu dem hinzu, was dort läuft, und überspringst. Du brauchst ein Konto auf demselben Server."
          }
        }
      }
    },
