            "value" : "Modellname"
          }
        }
      }
    },
    "More like this" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr davon"
          }
        }
      }
    },
    "Needs a key from Google AI Studio. The song list goes to generativelanguage.googleapis.com." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Braucht einen Schlüssel aus Google AI Studio. Die Songliste geht an generativelanguage.googleapis.com."
          }
        }
      }
    },
    "Needs a key from the Claude Console. The song list goes to api.anthropic.com. You pay the provider per request." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Braucht einen Schlüssel aus der Claude Console. Die Songliste geht an api.anthropic.com. Du zahlst pro Anfrage an den Anbieter."
