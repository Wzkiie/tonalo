        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinden"
          }
        }
      }
    },
    "Connect your Audiobookshelf server under Settings and listen in the same app, with chapters, speed, a sleep timer and your progress in sync." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde deinen Audiobookshelf-Server in den Einstellungen und höre alles in derselben App, mit Kapiteln, Tempo, Schlaftimer und abgeglichenem Fortschritt."
          }
        }
      }
    },
