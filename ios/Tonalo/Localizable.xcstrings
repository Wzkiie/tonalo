    },
    "Loading ahead keeps the music going when the connection drops for a moment. Volume leveling uses the ReplayGain tags of your files. Scrobbling tells your server what you listened to." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorladen hält die Musik am Laufen, wenn die Verbindung kurz abreißt. Die Lautstärkeangleichung nutzt die ReplayGain-Tags deiner Dateien. Beim Scrobbeln erfährt dein Server, was du gehört hast."
          }
        }
      }
    },
    "Loading albums, artists and playlists…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
