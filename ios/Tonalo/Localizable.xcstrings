      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hörbücher entdecken"
          }
        }
      }
    },
    "Download books and episodes just like music. Your position goes to the server as soon as there's a connection again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade Bücher und Folgen genauso herunter wie Musik. Deine Position geht an den Server, sobald wieder eine Verbindung besteht."
