    "What's New in Tonalo" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neu in Tonalo"
          }
        }
      }
    },
    "When an album or playlist ends, similar songs keep playing. You can turn it off in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endet ein Album oder eine Playlist, laufen ähnliche Songs weiter. Das lässt sich in den Einstellungen ausschalten."
