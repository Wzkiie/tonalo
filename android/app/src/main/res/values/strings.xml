    <!-- DJ -->
    <string name="dj">DJ</string>
    <string name="dj_settings">DJ settings</string>
    <string name="dj_intro">An AI model of your choice picks sets from your own library and puts them in order. It never talks. Off until you turn it on.</string>
    <string name="who_picks">Who picks the songs</string>
    <string name="ollama_own">Ollama (your own computer)</string>
    <string name="api_key">API key</string>
    <string name="save_key">Save key</string>
    <string name="delete_key">Delete key</string>
    <string name="key_saved">Key saved: %1$s</string>
    <string name="ollama_address">Address of your Ollama server</string>
    <string name="load_models">Load models</string>
    <string name="model">Model</string>
    <string name="model_info">Larger models choose better and cost more per set.</string>
    <string name="test">Test</string>
    <string name="test_ok">Works: %1$d songs picked.</string>
    <string name="what_is_sent">Sent per set: title, artist, album, genre, year and the favorite mark of about 150 songs, the last few songs the DJ played, and your wish if you type one. Never sent: your server address, your login, covers or your listening history. At most 20 requests an hour.</string>
    <string name="show_sent">Show what is sent</string>
    <string name="share_devices">Use on paired devices</string>
    <string name="share_info">Your own TV and computers paired with this account get the DJ too. Turned off, they lose it again the next time they are connected.</string>
    <string name="key_storage">Your key is stored encrypted on this phone only (and on your paired devices, if shared). It is not shown again, and only ever sent to %1$s. Tip: create a key just for Tonalo and set a spending limit with the provider.</string>
    <string name="consent_title">Turn on the DJ?</string>
    <string name="consent_text">For every set, Tonalo sends title, artist, album, genre, year and the favorite mark of about 150 of your songs, which songs the DJ played last, and your wish, directly from this phone to %1$s. What happens to it there follows that provider\'s terms. Tonalo itself receives nothing.</string>
    <string name="agree">Agree and turn on</string>
    <string name="share_consent_title">Share the DJ?</string>
    <string name="share_consent_text">Provider, model and your key (or your Ollama address) go to the TVs and computers paired with this account, encrypted, and only inside your home network. They then send song details to %1$s themselves.</string>
